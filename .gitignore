# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/dist/

# Production API URL (copy from dart_defines/production.json.example)
/dart_defines/production.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing — never commit. Keystore lives in GitHub Actions
# secrets (ANDROID_KEYSTORE_BASE64); keep an offline backup of the .jks too.
# Losing it means no future build can update an installed app.
android/key.properties
android/*.jks
android/keystore-password.txt
android/keystore-base64.txt
